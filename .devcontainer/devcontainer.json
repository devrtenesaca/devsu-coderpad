{
  "name": "Python 3.11 + PostgreSQL (DevContainer)",
  
  // Le dice a VS Code que use Docker Compose en lugar de una sola imagen
  "dockerComposeFile": "docker-compose.yaml",
  
  // El servicio donde se conectará VS Code para editar código
  "service": "app",
  
  // Ruta de trabajo dentro del contenedor
  "workspaceFolder": "/workspaces/devsu-coderpad",
  
  // Reenvía los puertos de Django y Postgres a tu máquina física
  "forwardPorts": [8000, 5432],

  // Extensiones útiles en VS Code
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "batisteo.vscode-django",
        "ckolkman.vscode-postgres"
      ]
    }
  },

  // Instala dependencias, espera 3 segundos a que Postgres inicie y corre las migraciones
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && sleep 3 && python app/manage.py migrate"
}
